# EN: Copy to .env.local, or rely on the central secrets file
# (~/.secrets/projets.env, path overridable with CENTRAL_ENV_FILE), which
# next.config.ts loads in local dev without overriding variables already set.
# Shared keys carry the LETMECOOK prefix to stay unique across projects.
# FR : Copier en .env.local, ou s'appuyer sur le fichier de secrets central
# (~/.secrets/projets.env, chemin modifiable par CENTRAL_ENV_FILE), charge par
# next.config.ts en developpement local sans ecraser les variables deja
# definies. Les cles partagees portent le prefixe LETMECOOK.
NEXT_PUBLIC_LETMECOOK_SUPABASE_URL=
NEXT_PUBLIC_LETMECOOK_SUPABASE_ANON_KEY=
NEXT_PUBLIC_LETMECOOK_APP_URL=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_YEARLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_LIFETIME=
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=
GROQ_API_KEY=
